<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ErpMobile.Pages.BarcodeScannerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    Title="مسح الباركود"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#111827">

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid
            Padding="16,12"
            ColumnDefinitions="*,Auto"
            BackgroundColor="#173B70">
            <Label
                Text="وجّه الكاميرا نحو الباركود"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Text="تم ✓ رجوع"
                Padding="12,6"
                CornerRadius="10"
                BackgroundColor="#25A36F"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnCancelClicked" />
        </Grid>

        <!-- شريط حالة المسح المتصل -->
        <Grid
            Grid.Row="1"
            Padding="16,8"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="10"
            BackgroundColor="#0F2E5C">
            <Border
                Padding="10,4"
                BackgroundColor="#25A36F"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10"
                VerticalOptions="Center">
                <Label
                    x:Name="ScanCountLabel"
                    Text="الأصناف المضافة: 0"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="White" />
            </Border>
            <Label
                Grid.Column="1"
                x:Name="ScanMessageLabel"
                Text="امسح أول صنف — يستمر المسح حتى تضغط «تم»"
                FontSize="12"
                TextColor="#BFD4F2"
                VerticalOptions="Center"
                LineBreakMode="TailTruncation" />
        </Grid>

        <Grid Grid.Row="2">
            <zxing:CameraBarcodeReaderView
                x:Name="CameraReader"
                IsDetecting="True"
                BarcodesDetected="OnBarcodesDetected" />

            <!-- معاينة الصنف المضاف — تظهر فوق الكاميرا لتوضيح أن الصنف أُضيف -->
            <Border
                x:Name="AddedCard"
                Margin="16,18"
                Padding="14,12"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                MaximumWidthRequest="400"
                IsVisible="False"
                Opacity="0">
                <Border.Shadow>
                    <Shadow Brush="#0B1B33" Offset="0,8" Radius="18" Opacity="0.45" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="11">
                    <Border
                        x:Name="AddedIconBox"
                        WidthRequest="38"
                        HeightRequest="38"
                        Padding="0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#33FFFFFF"
                        VerticalOptions="Center">
                        <Label
                            x:Name="AddedIcon"
                            Text="✓"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            x:Name="AddedName"
                            Text="تمت الإضافة"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White"
                            LineBreakMode="TailTruncation" />
                        <Label
                            x:Name="AddedDetail"
                            Text=""
                            FontSize="12"
                            TextColor="#EAF7F0"
                            Opacity="0.95"
                            LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
