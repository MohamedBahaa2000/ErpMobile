<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ErpMobile.Pages.BarcodeScannerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    Title="مسح الباركود"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#111827">

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid
            Padding="16,12"
            ColumnDefinitions="*,Auto"
            BackgroundColor="#173B70">
            <Label
                Text="وجّه الكاميرا نحو الباركود"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Text="تم ✓ رجوع"
                Padding="12,6"
                CornerRadius="10"
                BackgroundColor="#25A36F"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnCancelClicked" />
        </Grid>

        <!-- شريط حالة المسح المتصل -->
        <Grid
            Grid.Row="1"
            Padding="16,8"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="10"
            BackgroundColor="#0F2E5C">
            <Border
                Padding="10,4"
                BackgroundColor="#25A36F"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10"
                VerticalOptions="Center">
                <Label
                    x:Name="ScanCountLabel"
                    Text="الأصناف المضافة: 0"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="White" />
            </Border>
            <Label
                Grid.Column="1"
                x:Name="ScanMessageLabel"
                Text="امسح أول صنف — يستمر المسح حتى تضغط «تم»"
                FontSize="12"
                TextColor="#BFD4F2"
                VerticalOptions="Center"
                LineBreakMode="TailTruncation" />
        </Grid>

        <zxing:CameraBarcodeReaderView
            x:Name="CameraReader"
            Grid.Row="2"
            IsDetecting="True"
            BarcodesDetected="OnBarcodesDetected" />
    </Grid>
</ContentPage>
