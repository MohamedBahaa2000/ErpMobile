<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ErpMobile.Pages.PurchaseInvoicePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="فاتورة المشتريات"
    FlowDirection="RightToLeft"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F1F2F7">

    <ContentPage.Resources>
        <Style x:Key="FieldCaptionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#555B72" />
        </Style>
        <Style x:Key="FieldEntryStyle" TargetType="Entry">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#34445C" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="HorizontalTextAlignment" Value="End" />
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#34394F" />
        </Style>
        <Style x:Key="ComputedValueStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#34394F" />
            <Setter Property="HorizontalTextAlignment" Value="End" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- شريط الأدوات العلوي -->
        <Grid
            Padding="14,10"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="8"
            BackgroundColor="#B3541E">
            <Button
                Text="✕"
                WidthRequest="40"
                HeightRequest="36"
                Padding="0"
                CornerRadius="8"
                BackgroundColor="#FFFFFF"
                TextColor="#B3541E"
                FontAttributes="Bold"
                Clicked="OnCancelClicked" />
            <Label
                Grid.Column="1"
                x:Name="InvoiceHeaderLabel"
                Text="فاتورة مشتريات"
                FontSize="15"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center" />
            <Button
                Grid.Column="2"
                Text="جديد"
                HeightRequest="36"
                Padding="12,4"
                CornerRadius="8"
                BackgroundColor="#FFFFFF"
                TextColor="#B3541E"
                FontAttributes="Bold"
                Clicked="OnAddNewClicked" />
            <Button
                Grid.Column="3"
                Text="عرض الكل"
                HeightRequest="36"
                Padding="12,4"
                CornerRadius="8"
                BackgroundColor="#2A538A"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnShowAllClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="12" Spacing="12">

                <!-- بيانات الفاتورة -->
                <Border Padding="14" BackgroundColor="White" Stroke="#8582D5" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="بيانات فاتورة المشتريات" Style="{StaticResource CardTitleStyle}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                            <!-- رقم الفاتورة -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="رقم الفاتورة" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Entry x:Name="InvoiceNumberEntry" IsEnabled="False" Style="{StaticResource FieldEntryStyle}" TextColor="#7A8299" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- تاريخ الفاتورة -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="تاريخ الفاتورة" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#E8FFE8" Stroke="#8FD9A8" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <DatePicker x:Name="InvoiceDatePicker" FontSize="13" TextColor="#34445C" HeightRequest="40" BackgroundColor="Transparent" DateSelected="OnInvoiceInputChanged" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- المورد -->
                            <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                                <Label Text="المورد" Style="{StaticResource FieldCaptionStyle}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <Border Padding="8,0" BackgroundColor="#FFF8DC" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                        <Entry x:Name="SupplierEntry" Text="مورد نقدي" Style="{StaticResource FieldEntryStyle}" />
                                    </Border>
                                    <Button
                                        Grid.Column="1"
                                        Text="📋"
                                        WidthRequest="46"
                                        HeightRequest="40"
                                        Padding="0"
                                        CornerRadius="6"
                                        BackgroundColor="#EEF3FF"
                                        TextColor="#173B70"
                                        Clicked="OnPickSupplierClicked" />
                                </Grid>
                            </VerticalStackLayout>

                            <!-- نوع الفاتورة -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                                <Label Text="النوع" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Picker x:Name="InvoiceTypePicker" FontSize="13" TextColor="#34445C" HeightRequest="40" BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- المخزن -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                                <Label Text="المخزن" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Picker x:Name="StorePicker" FontSize="13" TextColor="#34445C" HeightRequest="40" BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- المندوب -->
                            <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="4">
                                <Label Text="المندوب" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Entry x:Name="RepEntry" Placeholder="-- اختر --" Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- السائق -->
                            <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="4">
                                <Label Text="السائق" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Entry x:Name="DriverEntry" Placeholder="-- اختر --" Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- اعتماد القيد المحاسبي -->
                            <VerticalStackLayout Grid.Row="4" Grid.Column="0" Spacing="4">
                                <Label Text="اعتماد القيد المحاسبي" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Picker x:Name="ApproveJournalPicker" FontSize="13" TextColor="#34445C" HeightRequest="40" BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- اعتماد حركة المخزن -->
                            <VerticalStackLayout Grid.Row="4" Grid.Column="1" Spacing="4">
                                <Label Text="اعتماد حركة المخزن" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Picker x:Name="ApproveStorePicker" FontSize="13" TextColor="#34445C" HeightRequest="40" BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- قائمة الأسعار -->
                            <VerticalStackLayout Grid.Row="5" Grid.ColumnSpan="2" Spacing="4">
                                <Label Text="قائمة الأسعار" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Picker x:Name="PriceListPicker" FontSize="13" TextColor="#34445C" HeightRequest="40" BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- بنود الفاتورة -->
                <Border Padding="14" BackgroundColor="White" Stroke="#8582D5" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="بنود الفاتورة" Style="{StaticResource CardTitleStyle}" />

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                            <Label Text="Barcode" FontSize="12" FontAttributes="Bold" TextColor="#555B72" VerticalOptions="Center" />
                            <Border Grid.Column="1" Padding="8,0" BackgroundColor="#F2FFD8" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                <Entry x:Name="BarcodeEntry" Placeholder="امسح الباركود أو أدخل كود الصنف" Style="{StaticResource FieldEntryStyle}" />
                            </Border>
                            <Button
                                Grid.Column="2"
                                x:Name="ScanButton"
                                Text="مسح"
                                HeightRequest="40"
                                Padding="10,4"
                                CornerRadius="6"
                                BackgroundColor="#36BFC5"
                                TextColor="White"
                                Clicked="OnScanBarcodeClicked" />
                            <Button
                                Grid.Column="3"
                                Text="إضافة"
                                HeightRequest="40"
                                Padding="10,4"
                                CornerRadius="6"
                                BackgroundColor="#25A36F"
                                TextColor="White"
                                Clicked="OnAddBarcodeClicked" />
                        </Grid>

                        <Label x:Name="ScanStatusLabel" Text="" FontSize="11" TextColor="#7A8299" />

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                            <Border WidthRequest="977" BackgroundColor="White" Stroke="#8582D5" StrokeThickness="1" StrokeShape="RoundRectangle 6">
                                <VerticalStackLayout Spacing="0">
                                    <Grid Padding="6" ColumnDefinitions="40,95,135,70,65,80,90,65,85,85,110,45" BackgroundColor="#F5E6DC">
                                        <Label Grid.Column="0" Text="م" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="كود الصنف" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="اسم الصنف" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="3" Text="الوحدة" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="4" Text="الكمية" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="5" Text="سعر الشراء" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="6" Text="اجمالي الصافي" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="7" Text="خصم %" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="8" Text="مبلغ الخصم" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="9" Text="الصافي" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="10" Text="ملاحظات" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="11" Text="حذف" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                    </Grid>

                                    <VerticalStackLayout x:Name="ItemsContainer" Spacing="0" />

                                    <Label
                                        x:Name="EmptyItemsLabel"
                                        Padding="10,16"
                                        Text="لا توجد بنود بعد — امسح باركود صنف أو أدخله يدوياً."
                                        FontSize="12"
                                        TextColor="#8A91A6"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- الخصومات والضرائب -->
                <Border Padding="14" BackgroundColor="White" Stroke="#8582D5" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="الخصومات والضرائب" Style="{StaticResource CardTitleStyle}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="نسبة الخصم %" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="White" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Entry x:Name="DiscountPercentEntry" Text="0" Keyboard="Numeric" Style="{StaticResource FieldEntryStyle}" TextChanged="OnInvoiceInputChanged" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="سبب الخصم" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="White" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Entry x:Name="DiscountReasonEntry" Placeholder="اختياري" Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                <Label Text="قيمة خصم الفاتورة" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Label x:Name="ExtraDiscountValueLabel" Text="0.00" Style="{StaticResource ComputedValueStyle}" Padding="0,10" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                <Label Text="ضريبة القيمة المضافة" Style="{StaticResource FieldCaptionStyle}" />
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox x:Name="VatCheckBox" IsChecked="True" Color="#25A36F" VerticalOptions="Center" CheckedChanged="OnInvoiceInputChanged" />
                                    <Label Text="نسبة %" FontSize="12" TextColor="#48546B" VerticalOptions="Center" />
                                    <Border WidthRequest="80" Padding="8,0" BackgroundColor="White" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                        <Entry x:Name="VatPercentEntry" Text="14" Keyboard="Numeric" Style="{StaticResource FieldEntryStyle}" TextChanged="OnInvoiceInputChanged" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                                <Label Text="اجمالي خصم الصنف" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Label x:Name="ItemsDiscountLabel" Text="0.00" Style="{StaticResource ComputedValueStyle}" Padding="0,10" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                                <Label Text="اجمالي قبل الخصم" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Label x:Name="SubtotalLabel" Text="0.00" Style="{StaticResource ComputedValueStyle}" Padding="0,10" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="4">
                                <Label Text="قيمة ضريبة القيمة المضافة" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Label x:Name="VatValueLabel" Text="0.00" Style="{StaticResource ComputedValueStyle}" Padding="0,10" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="4">
                                <Label Text="اجمالي الفاتورة" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#E1FFE4" Stroke="#8FD9A8" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Label x:Name="GrandTotalLabel" Text="0.00" Style="{StaticResource ComputedValueStyle}" Padding="0,10" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- السداد -->
                <Border Padding="14" BackgroundColor="White" Stroke="#8582D5" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="بيانات السداد" Style="{StaticResource CardTitleStyle}" />

                        <Grid Padding="6" ColumnDefinitions="40,110,150,95,115,170,45" BackgroundColor="#F5E6DC" ColumnSpacing="2">
                            <Label Grid.Column="0" Text="م" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="طريقة الدفع" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="اسم الحساب" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                            <Label Grid.Column="3" Text="المدفوع" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                            <Label Grid.Column="4" Text="تاريخ الدفع" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                            <Label Grid.Column="5" Text="ملاحظات" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                            <Label Grid.Column="6" Text="حذف" FontSize="11" FontAttributes="Bold" TextColor="#7A4A22" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout x:Name="PaymentsContainer" Spacing="0" />

                        <Button
                            Text="＋ إضافة سداد"
                            HeightRequest="38"
                            Padding="12,4"
                            CornerRadius="8"
                            BackgroundColor="#25A36F"
                            TextColor="White"
                            FontSize="12"
                            FontAttributes="Bold"
                            HorizontalOptions="Start"
                            Clicked="OnAddPaymentClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- ملخص الفاتورة -->
                <Border Padding="14" BackgroundColor="White" Stroke="#8582D5" StrokeThickness="2" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="ملخص الفاتورة" Style="{StaticResource CardTitleStyle}" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                            <Border Padding="10,8" BackgroundColor="#FDF3EC" Stroke="#F0CBAF" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="مبلغ الفاتورة" FontSize="12" TextColor="#555B72" HorizontalTextAlignment="Center" />
                                    <Label x:Name="InvoiceTotalLabel" Text="0.00" FontSize="17" FontAttributes="Bold" TextColor="#B3541E" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Padding="10,8" BackgroundColor="#EEFBF3" Stroke="#BCE6CE" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="المدفوع" FontSize="12" TextColor="#555B72" HorizontalTextAlignment="Center" />
                                    <Label x:Name="PaidTotalLabel" Text="0.00" FontSize="17" FontAttributes="Bold" TextColor="#248A58" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Padding="10,8" BackgroundColor="#FDEEEE" Stroke="#F2C2C2" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="المتبقي" FontSize="12" TextColor="#555B72" HorizontalTextAlignment="Center" />
                                    <Label x:Name="InvoiceRemainingLabel" Text="0.00" FontSize="17" FontAttributes="Bold" TextColor="#D9534F" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.ColumnSpan="3" Padding="14,10" BackgroundColor="#B3541E" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="صافي الفاتورة" FontSize="14" FontAttributes="Bold" TextColor="#FFE3CE" VerticalOptions="Center" />
                                    <Label x:Name="SummaryGrandTotalLabel" Grid.Column="1" Text="0.00" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- أزرار الحفظ -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Text="حفظ - تابع" HeightRequest="46" CornerRadius="8" BackgroundColor="#25A36F" TextColor="White" FontAttributes="Bold" Clicked="OnSaveAndContinueClicked" />
                    <Button Grid.Column="1" Text="حفظ وإغلاق" HeightRequest="46" CornerRadius="8" BackgroundColor="#E99A2D" TextColor="White" FontAttributes="Bold" Clicked="OnSaveClicked" />
                    <Button Grid.Column="2" Text="إلغاء" HeightRequest="46" CornerRadius="8" BackgroundColor="#D9534F" TextColor="White" FontAttributes="Bold" Clicked="OnCancelClicked" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
