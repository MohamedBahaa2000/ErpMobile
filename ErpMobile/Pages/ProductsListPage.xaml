<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ErpMobile.Pages.ProductsListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ErpMobile.Controls"
    FlowDirection="RightToLeft"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F4F7FC">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- الشريط العلوي — تدرّج أنيق + أزرار مدوّرة (Pills) -->
        <Grid
            Padding="16,12"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="10">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#173B70" Offset="0.0" />
                    <GradientStop Color="#2E5EA8" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Button
                Text="✕"
                WidthRequest="40"
                HeightRequest="40"
                Padding="0"
                CornerRadius="20"
                FontSize="15"
                FontAttributes="Bold"
                BackgroundColor="#FFFFFF"
                TextColor="#173B70"
                Clicked="OnCloseClicked" />
            <Label
                Grid.Column="1"
                x:Name="TitleLabel"
                Text="عرض الأصناف"
                FontSize="17"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center" />
            <Button
                Grid.Column="2"
                Text="⟳"
                WidthRequest="42"
                HeightRequest="40"
                Padding="0"
                CornerRadius="20"
                FontSize="19"
                FontAttributes="Bold"
                BackgroundColor="#FFFFFF"
                TextColor="#173B70"
                Clicked="OnReloadClicked" />
            <Button
                Grid.Column="3"
                Text="＋ إضافة"
                HeightRequest="40"
                Padding="18,0"
                CornerRadius="20"
                FontSize="14"
                FontAttributes="Bold"
                BackgroundColor="#7B74D6"
                TextColor="White"
                Clicked="OnAddClicked" />
        </Grid>

        <!-- بحث -->
        <Grid
            Grid.Row="1"
            Padding="14,10"
            ColumnDefinitions="*">
            <Border
                Padding="12,0"
                BackgroundColor="White"
                Stroke="#D5D4EC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label
                        Text="🔍"
                        FontSize="14"
                        TextColor="#9AA4B8"
                        VerticalOptions="Center" />
                    <Entry
                        Grid.Column="1"
                        x:Name="SearchEntry"
                        Placeholder="ابحث بالاسم أو الباركود أو الوحدة..."
                        FontSize="13"
                        TextColor="#192D4A"
                        PlaceholderColor="#9AA4B8"
                        HeightRequest="44"
                        TextChanged="OnSearchChanged" />
                </Grid>
            </Border>
        </Grid>

        <!-- شريط حالة الاتصال بالخادم -->
        <Border
            x:Name="ApiStatusBanner"
            Grid.Row="2"
            Margin="14,0,14,6"
            Padding="12,9"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            IsVisible="False">
            <Label
                x:Name="ApiStatusText"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center" />
        </Border>

        <!-- ملخّص — بطاقتان بأيقونة وقيمة بارزة -->
        <Grid
            Grid.Row="3"
            Padding="14,0,14,4"
            ColumnDefinitions="*,*"
            ColumnSpacing="10">
            <Border
                Padding="14,11"
                BackgroundColor="#F0EFFC"
                Stroke="#D5D4EC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="3">
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="📦" FontSize="12" />
                        <Label Text="عدد الأصناف" FontSize="11" TextColor="#7B74B4" />
                    </HorizontalStackLayout>
                    <Label x:Name="CountLabel" Text="0" FontSize="19" FontAttributes="Bold" TextColor="#6B62C7" />
                </VerticalStackLayout>
            </Border>
            <Border
                Grid.Column="1"
                Padding="14,11"
                BackgroundColor="#EAF9F0"
                Stroke="#A8E3C4"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="3">
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="💰" FontSize="12" />
                        <Label Text="قيمة المخزون (تجزئة)" FontSize="11" TextColor="#4A8A68" />
                    </HorizontalStackLayout>
                    <Label x:Name="TotalValueLabel" Text="0.00" FontSize="19" FontAttributes="Bold" TextColor="#12A15B" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- القائمة -->
        <ScrollView Grid.Row="4">
            <VerticalStackLayout Padding="14,6" Spacing="10">
                <Label
                    x:Name="EmptyLabel"
                    Text=""
                    FontSize="13"
                    TextColor="#8A91A6"
                    HorizontalTextAlignment="Center"
                    IsVisible="False" />
                <!--
                    FlexLayout بدل VerticalStackLayout: على الموبايل يبقى عمود واحد،
                    وعلى الشاشات العريضة (ويندوز) تُصفّ البطاقات في ٣-٤ أعمدة.
                -->
                <FlexLayout
                    x:Name="ListContainer"
                    Direction="Row"
                    Wrap="Wrap"
                    JustifyContent="Start"
                    AlignItems="Start" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- حمّلة الريلود — تغطي الصفحة كلها أثناء التحديث من الخادم -->
        <controls:ReloadOverlay x:Name="ReloadOverlay" Grid.RowSpan="5" />
    </Grid>
</ContentPage>
