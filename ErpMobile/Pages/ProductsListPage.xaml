<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ErpMobile.Pages.ProductsListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    FlowDirection="RightToLeft"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F4F7FC">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- الشريط العلوي -->
        <Grid
            Padding="16,12"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="10"
            BackgroundColor="#173B70">
            <Button
                Text="✕"
                WidthRequest="44"
                HeightRequest="38"
                Padding="0"
                CornerRadius="8"
                BackgroundColor="#FFFFFF"
                TextColor="#173B70"
                FontAttributes="Bold"
                Clicked="OnCloseClicked" />
            <Label
                Grid.Column="1"
                Text="عرض الأصناف"
                FontSize="17"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center" />
            <Button
                Grid.Column="2"
                Text="＋ إضافة"
                HeightRequest="38"
                Padding="14,4"
                CornerRadius="10"
                BackgroundColor="#6B62C7"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnAddClicked" />
        </Grid>

        <!-- بحث -->
        <Grid
            Grid.Row="1"
            Padding="14,10"
            ColumnDefinitions="*">
            <Border
                Padding="10,0"
                BackgroundColor="White"
                Stroke="#D5D4EC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">
                <Entry
                    x:Name="SearchEntry"
                    Placeholder="ابحث بالاسم أو الباركود أو الوحدة..."
                    FontSize="13"
                    TextColor="#192D4A"
                    PlaceholderColor="#9AA4B8"
                    HeightRequest="44"
                    TextChanged="OnSearchChanged" />
            </Border>
        </Grid>

        <!-- ملخص -->
        <Grid
            Grid.Row="2"
            Padding="14,0,14,4"
            ColumnDefinitions="*,*"
            ColumnSpacing="10">
            <Border
                Padding="12,9"
                BackgroundColor="#F0EFFC"
                Stroke="#D5D4EC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="عدد الأصناف" FontSize="11" TextColor="#7B74B4" />
                    <Label x:Name="CountLabel" Text="0" FontSize="17" FontAttributes="Bold" TextColor="#6B62C7" />
                </VerticalStackLayout>
            </Border>
            <Border
                Grid.Column="1"
                Padding="12,9"
                BackgroundColor="#EAF9F0"
                Stroke="#A8E3C4"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="قيمة المخزون (سعر التجزئة)" FontSize="11" TextColor="#4A8A68" />
                    <Label x:Name="TotalValueLabel" Text="0.00" FontSize="17" FontAttributes="Bold" TextColor="#12A15B" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- القائمة -->
        <ScrollView Grid.Row="3">
            <VerticalStackLayout Padding="14,6" Spacing="10">
                <Label
                    x:Name="EmptyLabel"
                    Text=""
                    FontSize="13"
                    TextColor="#8A91A6"
                    HorizontalTextAlignment="Center"
                    IsVisible="False" />
                <VerticalStackLayout
                    x:Name="ListContainer"
                    Spacing="10" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
