<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ErpMobile.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ErpMobile.Pages"
    xmlns:controls="clr-namespace:ErpMobile.Controls"
    Title="لوحة التحكم"
    FlowDirection="RightToLeft"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F4F7FC">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="16,20" Spacing="20">

            <!-- ================= شريط حالة الاتصال بالخادم ================= -->
            <VerticalStackLayout x:Name="StatusBannerContainer" Spacing="0" />

            <!-- ================= الترويسة المميّزة ================= -->
            <Border
                Padding="18,18"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#16295E" Offset="0.0" />
                        <GradientStop Color="#2458F2" Offset="0.60" />
                        <GradientStop Color="#37B7EA" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#1B2E6B" Offset="0,8" Radius="18" Opacity="0.28" />
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

                    <!-- أيقونة المستخدم (يمين في RTL) -->
                    <Border
                        WidthRequest="54"
                        HeightRequest="54"
                        BackgroundColor="#2EFFFFFF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 17"
                        VerticalOptions="Center">
                        <Label
                            Text="👤"
                            FontSize="26"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <!-- الترحيب -->
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3"
                        VerticalOptions="Center">
                        <Label
                            x:Name="WelcomeLabel"
                            Text="أهلاً بعودتك 👋"
                            FontSize="13"
                            TextColor="#D6E2FF" />
                        <Label
                            x:Name="UserNameLabel"
                            Text="المسؤول"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="White" />
                        <Label
                            x:Name="DateLabel"
                            Text=""
                            FontSize="11"
                            TextColor="#BFD2FF" />
                    </VerticalStackLayout>

                    <!-- زر تحديث البيانات (ريلود) -->
                    <Button
                        Grid.Column="2"
                        Text="⟳"
                        WidthRequest="46"
                        HeightRequest="46"
                        Padding="0"
                        CornerRadius="23"
                        FontSize="21"
                        FontAttributes="Bold"
                        BackgroundColor="#33FFFFFF"
                        TextColor="White"
                        Clicked="OnReloadClicked" />

                    <!-- زر تسجيل الخروج (يسار في RTL) -->
                    <Border
                        Grid.Column="3"
                        Padding="10"
                        BackgroundColor="#33FFFFFF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        HeightRequest="46"
                        WidthRequest="46"
                        VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLogoutClicked" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="🚪"
                            FontSize="20"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- ================= العمليات اليومية ================= -->
            <VerticalStackLayout Spacing="12">
                <Label
                    Text="ابدأ عمليتك"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#192D4A" />

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="12">

                    <!-- فاتورة بيع (الإجراء الأساسي) -->
                    <Border
                        Padding="16,16"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E1523D" Offset="0.0" />
                                <GradientStop Color="#F07A4E" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#E1523D" Offset="0,6" Radius="14" Opacity="0.30" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSalesAction" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🧾" FontSize="26" />
                            <Label Text="فاتورة بيع" FontSize="16" FontAttributes="Bold" TextColor="White" />
                            <Label Text="إنشاء فاتورة جديدة" FontSize="11" TextColor="#FFE3DB" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- منتج جديد -->
                    <Border
                        Grid.Column="1"
                        Padding="16,16"
                        BackgroundColor="White"
                        Stroke="#E5EAF2"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                        <Border.Shadow>
                            <Shadow Brush="#253B65" Offset="0,5" Radius="12" Opacity="0.07" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProductAction" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🏷" FontSize="26" />
                            <Label Text="منتج جديد" FontSize="16" FontAttributes="Bold" TextColor="#192D4A" />
                            <Label Text="إضافة صنف للمخزون" FontSize="11" TextColor="#8995A7" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- العملاء -->
                    <Border
                        Grid.Row="1"
                        Padding="16,16"
                        BackgroundColor="White"
                        Stroke="#E5EAF2"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                        <Border.Shadow>
                            <Shadow Brush="#253B65" Offset="0,5" Radius="12" Opacity="0.07" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCustomersAction" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="👥" FontSize="26" />
                            <Label Text="العملاء" FontSize="16" FontAttributes="Bold" TextColor="#192D4A" />
                            <Label Text="قائمة وإضافة عميل" FontSize="11" TextColor="#8995A7" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- الموردين -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="16,16"
                        BackgroundColor="White"
                        Stroke="#E5EAF2"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                        <Border.Shadow>
                            <Shadow Brush="#253B65" Offset="0,5" Radius="12" Opacity="0.07" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSuppliersAction" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🚚" FontSize="26" />
                            <Label Text="الموردين" FontSize="16" FontAttributes="Bold" TextColor="#192D4A" />
                            <Label Text="قائمة وإضافة مورد" FontSize="11" TextColor="#8995A7" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- عرض القوائم الكاملة -->
            <VerticalStackLayout Spacing="12">
                <Label
                    Text="عرض القوائم"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#192D4A" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button
                        Text="📄 كل الفواتير"
                        HeightRequest="48"
                        CornerRadius="13"
                        BackgroundColor="White"
                        BorderColor="#DCE3ED"
                        BorderWidth="1"
                        TextColor="#173B70"
                        FontAttributes="Bold"
                        FontSize="14"
                        Clicked="OnAllInvoicesClicked" />
                    <Button
                        Grid.Column="1"
                        Text="📦 كل الأصناف"
                        HeightRequest="48"
                        CornerRadius="13"
                        BackgroundColor="White"
                        BorderColor="#DCE3ED"
                        BorderWidth="1"
                        TextColor="#173B70"
                        FontAttributes="Bold"
                        FontSize="14"
                        Clicked="OnAllProductsClicked" />
                </Grid>
            </VerticalStackLayout>

            <!-- ================= بطاقة مبيعات اليوم ================= -->
            <Border
                Padding="20"
                BackgroundColor="#173B70"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20">
                <Border.Shadow>
                    <Shadow Brush="#173B70" Offset="0,7" Radius="16" Opacity="0.22" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="مبيعات اليوم"
                        FontSize="14"
                        TextColor="#D5E1F2" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label
                            x:Name="TodaySalesLabel"
                            Text="0.00"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="White"
                            VerticalOptions="Center" />
                        <Border
                            Grid.Column="1"
                            Padding="10,6"
                            BackgroundColor="#2A538A"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            VerticalOptions="Center">
                            <Label
                                x:Name="TodayInvoicesLabel"
                                Text="0 فاتورة"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#D8F5E5" />
                        </Border>
                    </Grid>
                    <Label
                        x:Name="OutstandingLabel"
                        Text="إجمالي المتبقي: 0.00"
                        FontSize="12"
                        TextColor="#D5E1F2" />
                </VerticalStackLayout>
            </Border>

            <!-- ================= التحليلات ================= -->
            <VerticalStackLayout Spacing="12">
                <Label
                    Text="التحليلات"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#192D4A" />

                <!-- مؤشرات سريعة -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10" RowDefinitions="Auto,Auto">
                    <Border
                        Padding="14,12"
                        BackgroundColor="#FFF4E8"
                        Stroke="#F5C89A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="💰 مبيعات" FontSize="12" TextColor="#8A6A4A" />
                            <Label x:Name="AnalyticsSalesLabel" Text="0.00" FontSize="20" FontAttributes="Bold" TextColor="#E1761B" />
                            <Label x:Name="AnalyticsSalesCountLabel" Text="0 فاتورة" FontSize="11" TextColor="#B08A62" />
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Padding="14,12"
                        BackgroundColor="#F0EFFC"
                        Stroke="#C9C6EE"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🏷 الأصناف" FontSize="12" TextColor="#6B62A0" />
                            <Label x:Name="AnalyticsProductsLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="#6B62C7" />
                            <Label x:Name="AnalyticsProductsValueLabel" Text="قيمة المخزون: 0.00" FontSize="11" TextColor="#948FC4" />
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Row="1"
                        Padding="14,12"
                        BackgroundColor="#E9F8FD"
                        Stroke="#A6E1F2"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="👥 العملاء" FontSize="12" TextColor="#4C8A9B" />
                            <Label x:Name="AnalyticsCustomersLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="#0E9BB8" />
                            <Label x:Name="AnalyticsCustomersBalanceLabel" Text="أرصدة: 0.00" FontSize="11" TextColor="#7BB6C4" />
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="14,12"
                        BackgroundColor="#EAF9F0"
                        Stroke="#A8E3C4"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🚚 الموردين" FontSize="12" TextColor="#4A8A68" />
                            <Label x:Name="AnalyticsSuppliersLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="#12A15B" />
                            <Label x:Name="AnalyticsSuppliersBalanceLabel" Text="أرصدة: 0.00" FontSize="11" TextColor="#7FC0A0" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- مبيعات آخر 7 أيام -->
                <Border
                    Padding="14"
                    BackgroundColor="White"
                    Stroke="#E5EAF2"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="مبيعات آخر 7 أيام" FontSize="14" FontAttributes="Bold" TextColor="#192D4A" />
                        <Grid
                            x:Name="SalesChartGrid"
                            ColumnDefinitions="*,*,*,*,*,*,*"
                            ColumnSpacing="8"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="4"
                            HeightRequest="140" />
                        <Label x:Name="SalesChartTotalLabel" Text="" FontSize="11" TextColor="#8995A7" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- الأصناف الأكثر مبيعاً -->
                <Border
                    Padding="14"
                    BackgroundColor="White"
                    Stroke="#E5EAF2"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="الأصناف الأكثر مبيعاً" FontSize="14" FontAttributes="Bold" TextColor="#192D4A" />
                        <VerticalStackLayout x:Name="TopProductsContainer" Spacing="6" />
                    </VerticalStackLayout>
                </Border>

                <!-- العملاء الأكثر شراءً -->
                <Border
                    Padding="14"
                    BackgroundColor="White"
                    Stroke="#E5EAF2"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="العملاء الأكثر شراءً" FontSize="14" FontAttributes="Bold" TextColor="#192D4A" />
                        <VerticalStackLayout x:Name="TopCustomersContainer" Spacing="6" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ================= أحدث الفواتير ================= -->
            <VerticalStackLayout Spacing="12">
                <Label
                    Text="أحدث الفواتير"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#192D4A" />
                <VerticalStackLayout
                    x:Name="RecentInvoicesContainer"
                    Spacing="0" />
            </VerticalStackLayout>

        </VerticalStackLayout>
        </ScrollView>

        <!-- حمّلة الريلود — تغطي الصفحة كلها أثناء التحديث من الخادم -->
        <controls:ReloadOverlay x:Name="ReloadOverlay" />
    </Grid>
</ContentPage>
