<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ErpMobile.Pages.InvoicePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="فاتورة المبيعات"
    FlowDirection="RightToLeft"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F1F2F7">

    <ContentPage.Resources>
        <Style x:Key="FieldCaptionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#555B72" />
        </Style>
        <Style x:Key="FieldEntryStyle" TargetType="Entry">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#34445C" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="HorizontalTextAlignment" Value="End" />
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#34394F" />
        </Style>
        <Style x:Key="ComputedValueStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#34394F" />
            <Setter Property="HorizontalTextAlignment" Value="End" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- شريط الأدوات العلوي -->
        <Grid
            Grid.Row="0"
            Padding="16,12"
            BackgroundColor="#E9EAF0"
            ColumnDefinitions="*,Auto">
            <Label
                Text="فاتورة المبيعات"
                FontSize="19"
                FontAttributes="Bold"
                TextColor="#48546B"
                VerticalOptions="Center" />
            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                <Button
                    Text="＋ إضافة (F9)"
                    HeightRequest="36"
                    Padding="12,4"
                    CornerRadius="8"
                    BackgroundColor="#25A36F"
                    TextColor="White"
                    FontSize="12"
                    FontAttributes="Bold"
                    Clicked="OnAddNewClicked" />
                <Button
                    Text="عرض الكل"
                    HeightRequest="36"
                    Padding="12,4"
                    CornerRadius="8"
                    BackgroundColor="#36BFC5"
                    TextColor="White"
                    FontSize="12"
                    Clicked="OnShowAllClicked" />
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="12,12,12,24" Spacing="12">

                <!-- بيانات الفاتورة -->
                <Border
                    Padding="14"
                    BackgroundColor="White"
                    Stroke="#8582D5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="بيانات الفاتورة" Style="{StaticResource CardTitleStyle}" />

                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                            ColumnSpacing="10"
                            RowSpacing="10">

                            <!-- المخزن -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                <Label Text="المخزن" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Picker
                                        x:Name="StorePicker"
                                        FontSize="13"
                                        TextColor="#34445C"
                                        HeightRequest="40"
                                        BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- رقم الفاتورة -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                <Label Text="رقم الفاتورة" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F7F7FB" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Entry
                                        x:Name="InvoiceNumberEntry"
                                        Placeholder="تلقائي"
                                        IsReadOnly="True"
                                        Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- تاريخ الفاتورة -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                <Label Text="تاريخ الفاتورة" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#E1FFE4" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <DatePicker
                                        x:Name="InvoiceDatePicker"
                                        FontSize="13"
                                        TextColor="#34445C"
                                        HeightRequest="40"
                                        BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- النوع -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                <Label Text="النوع" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#FDE7F1" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Picker
                                        x:Name="InvoiceTypePicker"
                                        FontSize="13"
                                        TextColor="#34445C"
                                        HeightRequest="40"
                                        BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- العميل -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                                <Label Text="العميل" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="White" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Entry
                                            x:Name="CustomerEntry"
                                            Text="عميل نقدي"
                                            Style="{StaticResource FieldEntryStyle}" />
                                        <Button
                                            Grid.Column="1"
                                            Text="بحث"
                                            HeightRequest="34"
                                            Padding="10,2"
                                            CornerRadius="6"
                                            BackgroundColor="#8582D5"
                                            TextColor="White"
                                            FontSize="11"
                                            Clicked="OnSearchCustomerClicked" />
                                    </Grid>
                                </Border>
                                <Label
                                    x:Name="CustomerBalanceLabel"
                                    Text="كارت العميل · رصيد سابق: 0.00"
                                    FontSize="11"
                                    TextColor="#D9534F" />
                            </VerticalStackLayout>

                            <!-- قائمة الأسعار -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                                <Label Text="السعر" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Picker
                                        x:Name="PriceListPicker"
                                        FontSize="13"
                                        TextColor="#34445C"
                                        HeightRequest="40"
                                        BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- المندوب -->
                            <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="4">
                                <Label Text="المندوب" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Entry
                                        x:Name="SalesRepEntry"
                                        Placeholder="-- اختر --"
                                        Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- السائق -->
                            <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="4">
                                <Label Text="السائق" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Entry
                                        x:Name="DriverEntry"
                                        Placeholder="-- اختر --"
                                        Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- اعتماد القيد المحاسبي -->
                            <VerticalStackLayout Grid.Row="4" Grid.Column="0" Spacing="4">
                                <Label Text="اعتماد القيد المحاسبي" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Picker
                                        x:Name="ApproveJournalPicker"
                                        FontSize="13"
                                        TextColor="#34445C"
                                        HeightRequest="40"
                                        BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- اعتماد حركة المخزن -->
                            <VerticalStackLayout Grid.Row="4" Grid.Column="1" Spacing="4">
                                <Label Text="اعتماد حركة المخزن" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Picker
                                        x:Name="ApproveStorePicker"
                                        FontSize="13"
                                        TextColor="#34445C"
                                        HeightRequest="40"
                                        BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- بنود الفاتورة -->
                <Border
                    Padding="14"
                    BackgroundColor="White"
                    Stroke="#8582D5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="بنود الفاتورة" Style="{StaticResource CardTitleStyle}" />

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                            <Label
                                Text="Barcode"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#555B72"
                                VerticalOptions="Center" />
                            <Border
                                Grid.Column="1"
                                Padding="8,0"
                                BackgroundColor="#F2FFD8"
                                Stroke="#D5D4EC"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 5">
                                <Entry
                                    x:Name="InvoiceBarcodeEntry"
                                    Placeholder="امسح الباركود أو أدخل كود الصنف"
                                    ReturnType="Go"
                                    Style="{StaticResource FieldEntryStyle}" />
                            </Border>
                            <Button
                                Grid.Column="2"
                                x:Name="ScanBarcodeButton"
                                Text="مسح"
                                HeightRequest="40"
                                Padding="10,4"
                                CornerRadius="6"
                                BackgroundColor="#36BFC5"
                                TextColor="White"
                                Clicked="OnScanBarcodeClicked" />
                            <Button
                                Grid.Column="3"
                                Text="إضافة"
                                HeightRequest="40"
                                Padding="10,4"
                                CornerRadius="6"
                                BackgroundColor="#25A36F"
                                TextColor="White"
                                Clicked="OnAddBarcodeClicked" />
                        </Grid>

                        <!-- ══ بحث عن الصنف بالاسم (تحت الباركود) ══ -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                            <Label
                                Text="اسم الصنف"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#555B72"
                                VerticalOptions="Center" />
                            <Border
                                Grid.Column="1"
                                Padding="8,0"
                                BackgroundColor="White"
                                Stroke="#D5D4EC"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 5">
                                <Entry
                                    x:Name="ItemSearchEntry"
                                    Placeholder="اكتب جزءاً من اسم الصنف للبحث..."
                                    FontSize="13"
                                    TextColor="#34445C"
                                    PlaceholderColor="#9AA4B8"
                                    ReturnType="Search"
                                    HeightRequest="40"
                                    TextChanged="OnItemSearchChanged" />
                            </Border>
                        </Grid>

                        <!-- نتائج البحث عن الصنف -->
                        <Border
                            x:Name="SearchResultsBorder"
                            Padding="0"
                            BackgroundColor="White"
                            Stroke="#C9D3E6"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            IsVisible="False">
                            <VerticalStackLayout Spacing="0">
                                <Label
                                    x:Name="SearchResultsTitle"
                                    Padding="10,7"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="#5A6480"
                                    BackgroundColor="#EEF2FA"
                                    Text="نتائج البحث" />
                                <VerticalStackLayout x:Name="SearchResultsContainer" Spacing="0" />
                            </VerticalStackLayout>
                        </Border>

                        <Label
                            x:Name="ScanStatusLabel"
                            Text="المسح المتصل يضيف عدة أصناف متتالية حتى تضغط «تم ✓ رجوع»"
                            FontSize="11"
                            TextColor="#7A8299" />

                        <!--
                            ═══ بنود الفاتورة ═══
                            بطاقات كاملة العرض بدل الجدول الأفقي بعرض 977:
                            كل صنف = بطاقة مدوّرة بإطار بنفسجي (نفس شكل لوحة
                            «الخصومات والضرائب») → لا تمرير أفقي على الموبايل،
                            وتظهر مرتّبة وأنيقة على شاشة الويندوز العريضة.
                        -->
                        <Label
                            x:Name="EmptyItemsLabel"
                            Text="امسح الباركود لإضافة صنف للفاتورة"
                            Padding="12"
                            FontSize="12"
                            TextColor="#8995A7"
                            HorizontalTextAlignment="Center" />
                        <VerticalStackLayout
                            x:Name="InvoiceItemsContainer"
                            Spacing="8" />
                    </VerticalStackLayout>
                </Border>

                <!-- الخصومات والضرائب -->
                <Border
                    Padding="14"
                    BackgroundColor="White"
                    Stroke="#8582D5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="الخصومات والضرائب" Style="{StaticResource CardTitleStyle}" />

                        <Label
                            Text="* عند تغيير نسبة الخصم / المبلغ سيتم حذف جميع الاحتسابات الحسابية في الفاتورة"
                            FontSize="11"
                            TextColor="#D9534F" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3">
                                <Label Text="نسبة الخصم %" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="White" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Entry
                                        x:Name="DiscountPercentEntry"
                                        Text="0"
                                        Keyboard="Numeric"
                                        Style="{StaticResource FieldEntryStyle}"
                                        TextChanged="OnInvoiceInputChanged" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
                                <Label Text="سبب الخصم" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="White" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Entry
                                        x:Name="DiscountReasonEntry"
                                        Placeholder="اختياري"
                                        Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="3">
                                <Label Text="قيمة خصم الفاتورة" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Label
                                        x:Name="ExtraDiscountValueLabel"
                                        Text="0.00"
                                        Style="{StaticResource ComputedValueStyle}"
                                        Padding="0,10" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                                <Label Text="ضريبة القيمة المضافة" Style="{StaticResource FieldCaptionStyle}" />
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        x:Name="VatCheckBox"
                                        IsChecked="True"
                                        Color="#25A36F"
                                        VerticalOptions="Center"
                                        CheckedChanged="OnVatCheckChanged" />
                                    <Label Text="نسبة %" FontSize="12" TextColor="#48546B" VerticalOptions="Center" />
                                    <Border
                                        WidthRequest="80"
                                        Padding="8,0"
                                        BackgroundColor="White"
                                        Stroke="#D5D4EC"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 5">
                                        <Entry
                                            x:Name="VatPercentEntry"
                                            Text="14"
                                            Keyboard="Numeric"
                                            Style="{StaticResource FieldEntryStyle}"
                                            TextChanged="OnInvoiceInputChanged" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="3">
                                <Label Text="اجمالي خصم الصنف" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Label x:Name="ItemsDiscountLabel" Text="0.00" Style="{StaticResource ComputedValueStyle}" Padding="0,10" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="3">
                                <Label Text="اجمالي قبل الخصم" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Label x:Name="SubtotalLabel" Text="0.00" Style="{StaticResource ComputedValueStyle}" Padding="0,10" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="3">
                                <Label Text="قيمة ضريبة القيمة المضافة" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#F0F0FA" Stroke="#D5D4EC" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Label x:Name="VatValueLabel" Text="0.00" Style="{StaticResource ComputedValueStyle}" Padding="0,10" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="3">
                                <Label Text="اجمالي الفاتورة" Style="{StaticResource FieldCaptionStyle}" />
                                <Border Padding="8,0" BackgroundColor="#E1FFE4" Stroke="#8FD9A8" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                                    <Label x:Name="GrandTotalLabel" Text="0.00" Style="{StaticResource ComputedValueStyle}" Padding="0,10" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- السداد -->
                <Border
                    Padding="14"
                    BackgroundColor="White"
                    Stroke="#8582D5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="بيانات السداد" Style="{StaticResource CardTitleStyle}" />

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                            <Border
                                WidthRequest="737"
                                BackgroundColor="White"
                                Stroke="#8582D5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6">
                                <VerticalStackLayout Spacing="0">
                                    <Grid
                                        Padding="6"
                                        ColumnDefinitions="40,110,150,95,115,170,45"
                                        BackgroundColor="#E9E9F0">
                                        <Label Grid.Column="0" Text="م" FontSize="11" FontAttributes="Bold" TextColor="#48546B" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="طريقة الدفع" FontSize="11" FontAttributes="Bold" TextColor="#48546B" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="اسم الحساب" FontSize="11" FontAttributes="Bold" TextColor="#48546B" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="3" Text="المدفوع" FontSize="11" FontAttributes="Bold" TextColor="#48546B" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="4" Text="تاريخ الدفع" FontSize="11" FontAttributes="Bold" TextColor="#48546B" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="5" Text="ملاحظات" FontSize="11" FontAttributes="Bold" TextColor="#48546B" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Column="6" Text="حذف" FontSize="11" FontAttributes="Bold" TextColor="#48546B" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                    </Grid>

                                    <VerticalStackLayout
                                        x:Name="PaymentsContainer"
                                        Spacing="0" />
                                </VerticalStackLayout>
                            </Border>
                        </ScrollView>

                        <Button
                            Text="＋ إضافة سداد"
                            HeightRequest="38"
                            Padding="12,4"
                            CornerRadius="8"
                            BackgroundColor="#25A36F"
                            TextColor="White"
                            FontSize="12"
                            FontAttributes="Bold"
                            HorizontalOptions="Start"
                            Clicked="OnAddPaymentClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- ملخص الفاتورة -->
                <Border
                    Padding="14"
                    BackgroundColor="White"
                    Stroke="#8582D5"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="ملخص الفاتورة" Style="{StaticResource CardTitleStyle}" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto">
                            <Border
                                Padding="10,8"
                                BackgroundColor="#EEF3FF"
                                Stroke="#C6D4F5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="مبلغ الفاتورة" FontSize="12" TextColor="#555B72" HorizontalTextAlignment="Center" />
                                    <Label x:Name="InvoiceTotalLabel" Text="0.00" FontSize="17" FontAttributes="Bold" TextColor="#173B70" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="10,8"
                                BackgroundColor="#EEFBF3"
                                Stroke="#BCE6CE"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="المدفوع" FontSize="12" TextColor="#555B72" HorizontalTextAlignment="Center" />
                                    <Label x:Name="PaidTotalLabel" Text="0.00" FontSize="17" FontAttributes="Bold" TextColor="#248A58" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border
                                Grid.Column="2"
                                Padding="10,8"
                                BackgroundColor="#FDEEEE"
                                Stroke="#F2C2C2"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="المتبقي" FontSize="12" TextColor="#555B72" HorizontalTextAlignment="Center" />
                                    <Label x:Name="InvoiceRemainingLabel" Text="0.00" FontSize="17" FontAttributes="Bold" TextColor="#D9534F" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Padding="14,10"
                                BackgroundColor="#173B70"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="صافي الفاتورة" FontSize="14" FontAttributes="Bold" TextColor="#BFD4F2" VerticalOptions="Center" />
                                    <Label
                                        x:Name="SummaryGrandTotalLabel"
                                        Grid.Column="1"
                                        Text="0.00"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        HorizontalTextAlignment="End"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <Label
                                Grid.Row="2"
                                Grid.ColumnSpan="3"
                                x:Name="InvoiceSummaryHint"
                                Text="أضف أصنافاً من قسم «بنود الفاتورة» ليتم احتساب الإجمالي تلقائياً"
                                FontSize="11"
                                TextColor="#8A91A6"
                                HorizontalTextAlignment="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- أزرار الحفظ -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button
                        Text="حفظ - تابع"
                        HeightRequest="46"
                        CornerRadius="8"
                        BackgroundColor="#25A36F"
                        TextColor="White"
