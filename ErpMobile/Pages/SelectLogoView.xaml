<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ErpMobile.Pages.SelectLogoView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- لوجو Select ERP مرسوم بعناصر أصلية (يظهر صح على Android و Windows) — الترتيب: Select ثم ERP -->
    <HorizontalStackLayout
        x:Name="LogoLayout"
        Spacing="8"
        FlowDirection="LeftToRight"
        VerticalOptions="Center">

        <Label
            x:Name="SelectLabel"
            Text="Select"
            FontAttributes="Bold"
            TextColor="#111827"
            VerticalOptions="Center" />

        <Border
            x:Name="ErpBadge"
            Padding="12,3"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 9"
            VerticalOptions="Center">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2821E8" Offset="0.0" />
                    <GradientStop Color="#2458F2" Offset="0.56" />
                    <GradientStop Color="#37B7EA" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Label
                x:Name="ErpLabel"
                Text="ERP"
                TextColor="White"
                FontAttributes="Bold"
                VerticalOptions="Center" />
        </Border>
    </HorizontalStackLayout>
</ContentView>
